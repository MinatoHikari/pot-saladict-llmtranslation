{
    "id": "plugin.com.saladict.llm-translate",
    "plugin_type": "translate",
    "icon": "icon.svg",
    "display": "DeepSeek / GLM 翻译",
    "homepage": "https://github.com/allentown521/saladict",
    "needs": [
        {
            "key": "endpoint",
            "display": "接口",
            "type": "select",
            "options": {
                "deepseek": "DeepSeek 官方 (api.deepseek.com)",
                "zai": "Z.ai 国际站 · 按量付费",
                "zai_coding": "Z.ai 国际站 · Coding Plan",
                "bigmodel": "智谱中国站 · 按量付费",
                "bigmodel_coding": "智谱中国站 · Coding Plan",
                "custom": "自定义 (OpenAI 兼容)"
            }
        },
        {
            "key": "customEndpoint",
            "display": "自定义接口地址 (选填，填了优先，如 http://127.0.0.1:8080/v1)",
            "type": "input"
        },
        {
            "key": "apiKey",
            "display": "API Key (本地服务可留空)",
            "type": "input"
        },
        {
            "key": "model",
